# Copy to .env and fill in. Never commit .env — it is gitignored.

# === REQUIRED to run the agent =============================================
# --- LiveKit ---------------------------------------------------------------
# The only credentials the voice stack needs. Speech-to-text, the LLM and
# text-to-speech all run through LiveKit Inference, which bills through
# LiveKit — you do NOT need a Deepgram, Inworld, Anthropic or OpenAI key.
# Get these from the LiveKit Cloud dashboard, or `lk cloud auth`.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound calls only. From `lk sip outbound list` after creating a trunk.
SIP_OUTBOUND_TRUNK_ID=

# === OPTIONAL — the agent starts and talks without these ===================
# --- HubSpot ---------------------------------------------------------------
# Leave blank until you have an account. Without it the agent still answers,
# checks stock, looks up orders and books appointments; it just cannot
# identify callers or write notes back to the CRM.
#
# Get one from HubSpot under **Development** (not Settings > Integrations,
# which no longer has it) — either route works, both are sent as a Bearer token:
#   Development > Keys > Service Keys   — simplest, intended for API-only access
#   Development > Legacy Apps           — the old private app flow, still supported
#
# Required scopes either way:
#   crm.objects.contacts.read, crm.objects.contacts.write,
#   crm.objects.deals.read,    crm.objects.deals.write,
#   crm.objects.owners.read
#
# NOT an OAuth access token. Those look like "CiRl...", last ~30 minutes, and
# fail with a misleading "expired 20677 day(s) ago".
HUBSPOT_ACCESS_TOKEN=

# --- Database --------------------------------------------------------------
# Port 5434: 5432 and 5433 are taken by other projects on this machine.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/voice_crm

# --- Model -----------------------------------------------------------------
# All served by LiveKit Inference — no separate provider keys.
# LiveKit Inference hosts google/, openai/, xai/, deepseek/ and kimi/ models.
# It does NOT host Anthropic or Meta Llama — "anthropic/..." will not work here.
# Current list: https://docs.livekit.io/agents/models/llm/
#
# gemma-4-31b-it is LiveKit's latency-optimised default and the cheapest
# option. If tool calling proves unreliable (invented order references,
# skipped tools), switch to a stronger model from the list above.
LLM_MODEL=google/gemma-4-31b-it
STT_MODEL=deepgram/nova-3
# "multi" is multilingual and slower. Use your actual language unless callers
# genuinely switch mid-call.
STT_LANGUAGE=en
# Silence before the agent decides you've finished speaking. Dead air on every
# turn — lower feels sharper, too low interrupts people who pause to think.
ENDPOINTING_MIN_DELAY=0.3
# Console mode has no caller ID. Set this to a seeded number (see
# scripts/demo_data.py) to test caller identification without a phone line.
# Ignored on real SIP calls.
CONSOLE_CALLER_PHONE=+15550100
# "unified" = one agent with every tool (default; measured faster, same
# accuracy, and the caller is never passed around). "specialists" = reception
# routes to four narrow agents. Compare with:
#   AGENT_MODE=specialists uv run python -m evals.run
AGENT_MODE=unified
TTS_MODEL=inworld/inworld-tts-2
TTS_VOICE=Ashley

# --- Observability ---------------------------------------------------------
# Optional. Leave blank and errors still go to the logs and the dashboard's
# error feed — Sentry just adds alerting and grouping on top. Skip it until
# something is actually deployed.
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=false
ENVIRONMENT=development
